<Window x:Class="AplicatieFarmacie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farmacia Verde - Gestiune Medicamente"
        Height="660" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F0">

    <Window.Resources>
        <Style x:Key="BtnVerde" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnRosu" TargetType="Button" BasedOn="{StaticResource BtnVerde}">
            <Setter Property="Background" Value="#C62828"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnGri" TargetType="Button" BasedOn="{StaticResource BtnVerde}">
            <Setter Property="Background" Value="#607D8B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#546E7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1B5E20">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Farmacia Verde" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Sistem de Gestiune a Medicamentelor" FontSize="11" Foreground="#A5D6A7"/>
                </StackPanel>
                <TextBlock x:Name="TxtDataOra" Grid.Column="1"
                           FontSize="13" Foreground="#C8E6C9"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- BARA BUTOANE -->
        <Border Grid.Row="1" Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Adauga Medicament"
                        Style="{StaticResource BtnVerde}"
                        Click="BtnAdauga_Click"/>

                <Button Grid.Column="1" Content="Editeaza"
                        Style="{StaticResource BtnGri}"
                        Click="BtnEditeaza_Click"/>

                <Button Grid.Column="2" Content="Sterge"
                        Style="{StaticResource BtnRosu}"
                        Click="BtnSterge_Click"/>

                <Border Grid.Column="4" Background="White"
                        BorderBrush="#A5D6A7" BorderThickness="1.5"
                        CornerRadius="4" VerticalAlignment="Center">
                    <Grid>
                        <TextBox x:Name="TxtCautare"
                                 FontSize="13" Padding="8,5"
                                 BorderThickness="0" Background="Transparent"
                                 TextChanged="TxtCautare_TextChanged"/>
                        <TextBlock Text="Cauta medicament..." IsHitTestVisible="False"
                                   Foreground="#BDBDBD" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtCautare}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Button Grid.Column="5" Content="Reseteaza"
                        Style="{StaticResource BtnGri}"
                        Margin="8,0,0,0"
                        Click="BtnReseteaza_Click"/>
            </Grid>
        </Border>

        <!-- CONTINUT PRINCIPAL -->
        <Grid Grid.Row="2" Margin="15,10,15,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Tabel medicamente -->
            <Border Grid.Column="0" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="4">
                <DataGrid x:Name="GridMedicamente"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="34"
                          FontSize="13"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F9FBF9"
                          BorderThickness="0"
                          SelectionChanged="GridMedicamente_SelectionChanged">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2E7D32"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="BorderBrush" Value="#1B5E20"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Denumire" Binding="{Binding Denumire}" Width="160"/>
                        <DataGridTextColumn Header="Producator" Binding="{Binding Producator}" Width="130"/>
                        <DataGridTextColumn Header="Categorie" Binding="{Binding Categorie}" Width="130"/>
                        <DataGridTextColumn Header="Pret (RON)" Binding="{Binding Pret, StringFormat={}{0:F2}}" Width="90"/>
                        <DataGridTextColumn Header="Stoc" Binding="{Binding Stoc}" Width="70"/>
                        <DataGridTextColumn Header="Expirare" Binding="{Binding DataExpirare, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Panou detalii -->
            <Border Grid.Column="2" Background="White" CornerRadius="4"
                    BorderBrush="#C8E6C9" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="Detalii Medicament" FontSize="13" FontWeight="Bold"
                               Foreground="#1B5E20" Margin="0,0,0,10"/>
                    <Separator Background="#C8E6C9" Margin="0,0,0,10"/>

                    <TextBlock Text="Denumire" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="DetDenumire" FontSize="13" FontWeight="SemiBold"
                               Foreground="#212121" Margin="0,2,0,9" TextWrapping="Wrap"/>

                    <TextBlock Text="Producator" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="DetProducator" FontSize="13" Foreground="#212121" Margin="0,2,0,9"/>

                    <TextBlock Text="Categorie" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="DetCategorie" FontSize="13" Foreground="#212121" Margin="0,2,0,9"/>

                    <TextBlock Text="Pret" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="DetPret" FontSize="13" Foreground="#2E7D32"
                               FontWeight="Bold" Margin="0,2,0,9"/>

                    <TextBlock Text="Stoc" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="DetStoc" FontSize="13" Foreground="#212121" Margin="0,2,0,9"/>

                    <TextBlock Text="Data expirare" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="DetExpirare" FontSize="13" Foreground="#212121" Margin="0,2,0,9"/>

                    <TextBlock Text="Descriere" Foreground="#888" FontSize="11"/>
                    <TextBlock x:Name="DetDescriere" FontSize="12" Foreground="#424242"
                               TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="18"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#1B5E20">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Foreground="#C8E6C9" FontSize="12"
                           VerticalAlignment="Center" Text="Selectati un medicament din lista."/>
                <TextBlock x:Name="TxtTotal" Grid.Column="1" Foreground="White"
                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
